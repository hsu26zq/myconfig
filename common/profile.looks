FMT_RESET="\e[0m"
FG_WHITE="\e[97m"
FG_CYAN="\e[36m"

# Red -> orange gradient, left to right (R and B fixed, G ramps 0 -> 165)
FG_GRAD_1="\e[38;2;255;0;0m"
BG_GRAD_1="\e[48;2;255;0;0m"
FG_GRAD_2="\e[38;2;255;55;0m"
BG_GRAD_2="\e[48;2;255;55;0m"
FG_GRAD_3="\e[38;2;255;110;0m"
BG_GRAD_3="\e[48;2;255;110;0m"
FG_GRAD_4="\e[38;2;255;165;0m"
BG_GRAD_4="\e[48;2;255;165;0m"

SEP=$''

PS1=\
"\n\[${BG_GRAD_1}\] \[${FG_WHITE}\]\u \[${FMT_RESET}\]"\
"\[${FG_GRAD_1}${BG_GRAD_2}\]${SEP}\[${FMT_RESET}\]"\
"\[${BG_GRAD_2}\] \[${FG_WHITE}\]\h \[${FMT_RESET}\]"\
"\[${FG_GRAD_2}${BG_GRAD_3}\]${SEP}\[${FMT_RESET}\]"\
"\[${BG_GRAD_3}\] \[${FG_WHITE}\]\w \[${FMT_RESET}\]"\
"\[${FG_GRAD_3}${BG_GRAD_4}\]${SEP}\[${FMT_RESET}\]"\
"\[${BG_GRAD_4}\] \[${FG_WHITE}\]\A \[${FMT_RESET}\]"\
"\$(branch=\$(git symbolic-ref --quiet --short HEAD 2>/dev/null) && "\
"printf '\[${FG_GRAD_4}${BG_GRAD_4}\]${SEP}\[${FMT_RESET}\]\[${BG_GRAD_4}\] \[${FG_WHITE}\]%s \[${FMT_RESET}\]\[${FG_GRAD_4}\]${SEP}\[${FMT_RESET}\]' \"\$branch\" || "\
"printf '\[${FG_GRAD_4}\]${SEP}\[${FMT_RESET}\]')"\
"\n \[${FG_CYAN}\]❯ \[${FMT_RESET}\]"
