# ~/.tmux.conf
#
# NORMAL  = green
# PANE    = light grey
# TAB     = medium grey
# SESSION = dark grey
# NEW     = blue flash
# DELETE  = red flash
#
# SESSION mode shows:
# SESSION [ 1/10 ]
# SESSION [ 2/10 ]
#
# PANE mode:
# Space = toggle zoom/full-screen

set -g detach-on-destroy off

set -g @control_mode "NORMAL"
set -g @session_position "[ 1/1 ]"

set -g status-style "bg=green,fg=black"
set -g status-left-length 40

set -g status-left '#{@control_mode}#{?#{==:#{@control_mode},SESSION}, #{@session_position},} | '
set -g status-right 'Window #I:#W'


# ENTER CONTROL MODE

bind-key -n C-Up \
    set -g @control_mode "PANE" \;\
    set -g status-style "bg=colour250,fg=black" \;\
    switch-client -T pane_mode

bind-key -n C-Down \
    set -g @control_mode "SESSION" \;\
    set -g status-style "bg=colour238,fg=white" \;\
    run-shell 'client="#{client_name}"; current=$(tmux display-message -p -c "$client" "##{session_id}"); sessions=$(tmux list-sessions -F "##{session_id}"); total=$(printf "%s\n" "$sessions" | wc -l); pos=$(printf "%s\n" "$sessions" | grep -nFx "$current" | cut -d: -f1); tmux set -g @session_position "[ $pos/$total ]"' \;\
    switch-client -T session_mode


# PANE MODE

bind-key -T pane_mode C-Up \
    set -g @control_mode "TAB" \;\
    set -g status-style "bg=colour244,fg=black" \;\
    switch-client -T window_mode

bind-key -T pane_mode C-Down \
    set -g @control_mode "SESSION" \;\
    set -g status-style "bg=colour238,fg=white" \;\
    run-shell 'client="#{client_name}"; current=$(tmux display-message -p -c "$client" "##{session_id}"); sessions=$(tmux list-sessions -F "##{session_id}"); total=$(printf "%s\n" "$sessions" | wc -l); pos=$(printf "%s\n" "$sessions" | grep -nFx "$current" | cut -d: -f1); tmux set -g @session_position "[ $pos/$total ]"' \;\
    switch-client -T session_mode

bind-key -T pane_mode Left \
    select-pane -t :.- \;\
    switch-client -T pane_mode

bind-key -T pane_mode Right \
    select-pane -t :.+ \;\
    switch-client -T pane_mode

bind-key -T pane_mode Space \
    resize-pane -Z \;\
    switch-client -T pane_mode

bind-key -T pane_mode n \
    set -g status-style "bg=blue,fg=white" \;\
    split-window \;\
    run-shell 'sleep 0.25; tmux set -g status-style "bg=colour250,fg=black"' \;\
    switch-client -T pane_mode

bind-key -T pane_mode BSpace \
    set -g status-style "bg=red,fg=white" \;\
    kill-pane \;\
    run-shell 'sleep 0.25; tmux set -g status-style "bg=colour250,fg=black"' \;\
    switch-client -T pane_mode

bind-key -T pane_mode Escape \
    set -g @control_mode "NORMAL" \;\
    set -g status-style "bg=green,fg=black" \;\
    switch-client -T root

bind-key -T pane_mode Any \
    switch-client -T pane_mode


# TAB MODE

bind-key -T window_mode C-Up \
    set -g @control_mode "SESSION" \;\
    set -g status-style "bg=colour238,fg=white" \;\
    run-shell 'client="#{client_name}"; current=$(tmux display-message -p -c "$client" "##{session_id}"); sessions=$(tmux list-sessions -F "##{session_id}"); total=$(printf "%s\n" "$sessions" | wc -l); pos=$(printf "%s\n" "$sessions" | grep -nFx "$current" | cut -d: -f1); tmux set -g @session_position "[ $pos/$total ]"' \;\
    switch-client -T session_mode

bind-key -T window_mode C-Down \
    set -g @control_mode "PANE" \;\
    set -g status-style "bg=colour250,fg=black" \;\
    switch-client -T pane_mode

bind-key -T window_mode Left \
    previous-window \;\
    switch-client -T window_mode

bind-key -T window_mode Right \
    next-window \;\
    switch-client -T window_mode

bind-key -T window_mode n \
    set -g status-style "bg=blue,fg=white" \;\
    new-window \;\
    run-shell 'sleep 0.25; tmux set -g status-style "bg=colour244,fg=black"' \;\
    switch-client -T window_mode

bind-key -T window_mode BSpace \
    set -g status-style "bg=red,fg=white" \;\
    kill-window \;\
    run-shell 'sleep 0.25; tmux set -g status-style "bg=colour244,fg=black"' \;\
    switch-client -T window_mode

bind-key -T window_mode Escape \
    set -g @control_mode "NORMAL" \;\
    set -g status-style "bg=green,fg=black" \;\
    switch-client -T root

bind-key -T window_mode Any \
    switch-client -T window_mode


# SESSION MODE

bind-key -T session_mode C-Up \
    set -g @control_mode "PANE" \;\
    set -g status-style "bg=colour250,fg=black" \;\
    switch-client -T pane_mode

bind-key -T session_mode C-Down \
    set -g @control_mode "TAB" \;\
    set -g status-style "bg=colour244,fg=black" \;\
    switch-client -T window_mode

bind-key -T session_mode Left \
    switch-client -p \;\
    run-shell 'client="#{client_name}"; current=$(tmux display-message -p -c "$client" "##{session_id}"); sessions=$(tmux list-sessions -F "##{session_id}"); total=$(printf "%s\n" "$sessions" | wc -l); pos=$(printf "%s\n" "$sessions" | grep -nFx "$current" | cut -d: -f1); tmux set -g @session_position "[ $pos/$total ]"' \;\
    switch-client -T session_mode

bind-key -T session_mode Right \
    switch-client -n \;\
    run-shell 'client="#{client_name}"; current=$(tmux display-message -p -c "$client" "##{session_id}"); sessions=$(tmux list-sessions -F "##{session_id}"); total=$(printf "%s\n" "$sessions" | wc -l); pos=$(printf "%s\n" "$sessions" | grep -nFx "$current" | cut -d: -f1); tmux set -g @session_position "[ $pos/$total ]"' \;\
    switch-client -T session_mode

bind-key -T session_mode n \
    set -g status-style "bg=blue,fg=white" \;\
    new-session \;\
    run-shell 'client="#{client_name}"; current=$(tmux display-message -p -c "$client" "##{session_id}"); sessions=$(tmux list-sessions -F "##{session_id}"); total=$(printf "%s\n" "$sessions" | wc -l); pos=$(printf "%s\n" "$sessions" | grep -nFx "$current" | cut -d: -f1); tmux set -g @session_position "[ $pos/$total ]"; sleep 0.25; tmux set -g status-style "bg=colour238,fg=white"' \;\
    switch-client -T session_mode

bind-key -T session_mode BSpace \
    set -g status-style "bg=red,fg=white" \;\
    kill-session \;\
    run-shell 'sleep 0.05; client="#{client_name}"; current=$(tmux display-message -p -c "$client" "##{session_id}"); sessions=$(tmux list-sessions -F "##{session_id}"); total=$(printf "%s\n" "$sessions" | wc -l); pos=$(printf "%s\n" "$sessions" | grep -nFx "$current" | cut -d: -f1); tmux set -g @session_position "[ $pos/$total ]"; sleep 0.20; tmux set -g status-style "bg=colour238,fg=white"' \;\
    switch-client -T session_mode

bind-key -T session_mode Escape \
    set -g @control_mode "NORMAL" \;\
    set -g status-style "bg=green,fg=black" \;\
    switch-client -T root

bind-key -T session_mode Any \
    switch-client -T session_mode
