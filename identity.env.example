# Copy this file to identity.env and fill in real values.
# identity.env is gitignored - it never gets committed or pushed.
# A machine with no identity.env just skips this part entirely.
#
# This file is sourced as shell code - always quote any value containing a
# space (like a name), or it will break.

GIT_EMAIL=you@example.com
GIT_NAME="Your Name"

# Optional - only used if set. Enables `ssh buildhost` / `ssh board`.
BUILDHOST_IP=10.0.0.1
BUILDHOST_USER=youruser
BOARD_IP=192.168.1.1
BOARD_USER=root
